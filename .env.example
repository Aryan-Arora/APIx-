# --- Pipeline / data-plane vars (owned by Engineer A) ---

# SQLAlchemy connection string. Defaults to local SQLite (sqlite:///apix.db)
# when unset. Point this at Postgres/Supabase in production, e.g.:
# postgresql+psycopg2://user:password@host:5432/apix
DATABASE_URL=

# Deterministic seed for the synthetic fare simulator (pipeline/apix/adapters/simulator.py).
SIMULATOR_SEED=42

# Max requests/sec for any live scraping adapter's rate limiter (pipeline/apix/compliance.py).
SCRAPE_MAX_RPS=0.5

# Outbound proxy for scraping, if needed to avoid IP-based blocking. Optional.
PROXY_URL=

# --- Other engineers' vars (Engineer B: api/, web/) ---
# API_KEYS=   # placeholder — see api/ for actual usage, not defined by the data plane
